#!/bin/bash
set -euo pipefail

CACHE_URI="${BUILDKITE_PLUGIN_GIT_BUNDLE_GCS_URI}"
CO="${BUILDKITE_BUILD_CHECKOUT_PATH}"
REPO="${BUILDKITE_REPO}"
COMMIT="${BUILDKITE_COMMIT}"
CLONE_FLAGS="${BUILDKITE_GIT_CLONE_FLAGS:--v}"
FETCH_FLAGS="${BUILDKITE_GIT_FETCH_FLAGS:--v}"

DOWNLOAD_TIMEOUT="${BUILDKITE_PLUGIN_GIT_BUNDLE_DOWNLOAD_TIMEOUT:-120}"
GIT_TIMEOUT="${BUILDKITE_PLUGIN_GIT_BUNDLE_GIT_TIMEOUT:-180}"
LOCAL_TIMEOUT=60
TIMEOUT_EXIT=128

WORK="$(mktemp -d)"
TAR="${WORK}/git-cache.tar"
ERR="${WORK}/stderr"
trap 'rm -rf "${WORK}"' EXIT

ATTEMPT=0
PHASE_RC=0

log() {
  printf 'git-bundle: [%s +%ss] %s\n' "$(date -u +%H:%M:%S)" "${SECONDS}" "$*"
}

# A hung gcloud/git call keeps a job silent until the step timeout, so every
# external call that touches the network runs under `timeout`. GNU and busybox
# both take `-k <grace> <secs> <cmd>`; busybox older than 1.30 has no -k.
TIMEOUT=()
if timeout -k 1 5 true 2>/dev/null; then
  TIMEOUT=(timeout -k 10)
elif timeout 5 true 2>/dev/null; then
  TIMEOUT=(timeout)
else
  log "warning: no usable timeout binary, running without hard limits"
fi

limited() {
  local limit=$1
  shift
  if [ "${#TIMEOUT[@]}" -eq 0 ]; then
    "$@"
  else
    "${TIMEOUT[@]}" "${limit}" "$@"
  fi
}

# timeout(1) exits 124 on TERM, 137 when it had to KILL.
is_timeout() {
  case "$1" in
    124 | 137) return 0 ;;
  esac
  return 1
}

# Runs <fn> (a shell function, so it can read ATTEMPT) up to twice and leaves
# the last exit status in PHASE_RC.
run_phase() {
  local name=$1 fn=$2 start
  PHASE_RC=0
  for ATTEMPT in 1 2; do
    start=${SECONDS}
    log "${name}: start (attempt ${ATTEMPT}/2)"
    PHASE_RC=0
    "${fn}" || PHASE_RC=$?
    if [ "${PHASE_RC}" -eq 0 ]; then
      log "${name}: ok in $((SECONDS - start))s"
      return 0
    fi
    if is_timeout "${PHASE_RC}"; then
      log "${name}: TIMED OUT after $((SECONDS - start))s"
    else
      log "${name}: failed (exit ${PHASE_RC}) after $((SECONDS - start))s: $(tail -c 200 "${ERR}" 2>/dev/null | tr '\n' ' ')"
    fi
    : >"${ERR}"
    if [ "${ATTEMPT}" -lt 2 ]; then
      sleep 2
    fi
  done
  return "${PHASE_RC}"
}

# Exit 128 so the step's `exit_status: 128` automatic retry gives the job a fresh pod.
abort_timeout() {
  log "${1}: hung twice, exiting ${TIMEOUT_EXIT} so the step is retried"
  buildkite-agent annotate --context git-bundle --style warning \
    "checkout phase '${1}' timed out twice, step exits ${TIMEOUT_EXIT} for a retry" 2>/dev/null || true
  exit "${TIMEOUT_EXIT}"
}

fail_phase() {
  if is_timeout "${PHASE_RC}"; then
    abort_timeout "$1"
  fi
  log "${1}: failed twice (exit ${PHASE_RC})"
  exit "${PHASE_RC}"
}

reset_checkout_dir() {
  cd /
  rm -rf "${CO:?}"
  mkdir -p "${CO}"
  cd "${CO}"
}

normal_clone() {
  if [ "${ATTEMPT}" -gt 1 ]; then
    reset_checkout_dir
  fi
  # shellcheck disable=SC2086
  limited "${GIT_TIMEOUT}" git clone ${CLONE_FLAGS} -- "${REPO}" . 2>"${ERR}"
}

normal_fetch() {
  # shellcheck disable=SC2086
  limited "${GIT_TIMEOUT}" git fetch ${FETCH_FLAGS} -- origin "${COMMIT}" 2>"${ERR}"
}

normal_checkout() {
  if [ ! -d .git ]; then
    run_phase "clone" normal_clone || fail_phase "clone"
  fi
  git remote set-url origin "${REPO}"
  run_phase "fetch" normal_fetch || fail_phase "fetch"
  log "checkout: ${COMMIT}"
  git checkout -f "${COMMIT}"
  git clean -ffxdq
}

download_cache() {
  # Per-attempt file: a gcloud child that outlives its timeout must not write into the retry's file.
  limited "${DOWNLOAD_TIMEOUT}" gcloud storage cp "${CACHE_URI}" "${TAR}.${ATTEMPT}" 2>"${ERR}" &&
    mv "${TAR}.${ATTEMPT}" "${TAR}"
}

extract_cache() {
  limited "${LOCAL_TIMEOUT}" tar -xf "${TAR}" -C "${CO}" 2>"${ERR}" && [ -d "${CO}/.git" ]
}

seed_fetch() {
  git remote set-url origin "${REPO}"
  log "fetching only the commit delta from GitHub ↓↓↓"
  # shellcheck disable=SC2086
  limited "${GIT_TIMEOUT}" git fetch ${FETCH_FLAGS} -- origin "${COMMIT}" 2>"${ERR}" &&
    limited "${LOCAL_TIMEOUT}" git checkout -f "${COMMIT}" 2>"${ERR}" &&
    git clean -ffxdq
}

log "start: commit=${COMMIT:0:12} cache=${CACHE_URI} download_timeout=${DOWNLOAD_TIMEOUT}s git_timeout=${GIT_TIMEOUT}s"

mkdir -p "${CO}"
cd "${CO}"

if [ -d .git ]; then
  normal_checkout
  log "done (existing checkout)"
  exit 0
fi

# Only seed plain depth-1 checkouts. Steps asking for deeper history or tags
# (release/deploy, monorepo-diff "Detect changes" via git-flags) need real
# history -> Buildkite's normal checkout.
case " ${CLONE_FLAGS} ${FETCH_FLAGS} " in
  *" --depth=1 "*) : ;;
  *) log "non-shallow step, using normal checkout"; normal_checkout; log "done"; exit 0 ;;
esac
case " ${CLONE_FLAGS} ${FETCH_FLAGS} " in
  *"--tags"*) log "tags requested, using normal checkout"; normal_checkout; log "done"; exit 0 ;;
esac

if ! run_phase "download" download_cache; then
  if is_timeout "${PHASE_RC}"; then
    abort_timeout "download"
  fi
  log "cache unavailable; normal checkout"
  normal_checkout
  log "done (normal checkout)"
  exit 0
fi
log "downloaded git cache from GCS (in-infra): $(du -h "${TAR}" | cut -f1)"

seed_ok=false
if run_phase "extract" extract_cache; then
  if run_phase "seed-fetch" seed_fetch; then
    seed_ok=true
  elif is_timeout "${PHASE_RC}"; then
    abort_timeout "seed-fetch"
  fi
elif is_timeout "${PHASE_RC}"; then
  abort_timeout "extract"
fi
rm -f "${TAR}"

if [ "${seed_ok}" = true ]; then
  log "SEEDED from GCS cache — GitHub served only the delta above (vs a full ~97MB clone). .git=$(du -sh .git 2>/dev/null | cut -f1)"
  buildkite-agent annotate --context git-bundle --style success "seeded from GCS cache OK" 2>/dev/null || true
else
  log "seed failed; falling back to normal checkout"
  reset_checkout_dir
  normal_checkout
fi
log "done"
